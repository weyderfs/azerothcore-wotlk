###################################################################################################
#  MOD-CUSTOM-CLASSES SETTINGS
#
#   ModCustomClasses.Enabled
#       Description: Enable or disable the custom classes module.
#       Default:    true  - (enabled)
#                   false - (disabled)
#
ModCustomClasses.Enabled = true

###################################################################################################
#  AVALON PROTOCOL PROBE
#
#   Envia AVALON_SMSG_PROBE (0x0A00) para sessoes conectadas ainda no char select.
#   Serve para provar o caminho servidor -> extensao de cliente. Desligar em producao.
#
Avalon.Probe.Enable = true
Avalon.Probe.Interval = 5000

###################################################################################################
#  BLOODMAGE (class 13)
#
#  Spells iniciais concedidos no login. Idempotente (hasSpell antes de aprender).
#
Avalon.Bloodmage.Enable = true
Avalon.Bloodmage.StarterSpells = "133,116,686,1454,172"
